{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feloosy-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "vars": {
    // Comma separated. The site address(es) allowed to call the API from a browser.
    "ALLOWED_ORIGINS": "https://feloosy.pages.dev,http://localhost:3000,http://localhost:4173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feloosy",
      "database_id": "TODO-create-on-deploy",
      "migrations_dir": "migrations"
    }
  ]
}
